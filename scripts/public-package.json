{
  "name": "standrig-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "powershell -NoProfile -File scripts/build-native.ps1",
    "test": "dotnet run --project native/Connect.Tests -c Release",
    "build:evaluator": "node scripts/build-evaluator.mjs",
    "test:finite": "node --experimental-strip-types scripts/evaluation/test-finite-packet.mjs",
    "test:geometry": "node scripts/evaluation/test-final-geometry.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.1.3",
    "@types/node": "24.13.2"
  }
}
